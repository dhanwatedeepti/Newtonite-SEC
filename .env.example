# PostgreSQL Configuration (Docker & Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=newtonite_db
POSTGRES_PORT=5432

# Application Database URL
# For PostgreSQL (Docker): postgresql://postgres:postgres@localhost:5432/newtonite_db
# For SQLite local fallback / testing without Docker: sqlite:///./newtonite.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newtonite_db

# Security & Sessions
SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
SESSION_COOKIE_NAME=newtonite_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_SECRET=dev-csrf-secret-key-change-in-production-32-chars

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
